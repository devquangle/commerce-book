# ========================================================
# eKYC Service – Git Ignore Configurations
# ========================================================

# Môi trường ảo Python
venv/
.venv/
env/
ENV/
dist/
build/

# Cache của Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Uploads và File tạm của eKYC Service (Chỉ giữ lại file .gitkeep)
uploads/*
!uploads/.gitkeep
temp/*
!temp/.gitkeep

# Nhật ký (Logs)
*.log
logs/

# Cấu hình của các IDE (VS Code, PyCharm, v.v.)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Hệ điều hành
.DS_Store
Thumbs.db

# Mô hình AI tải về cục bộ (nếu có cache trong thư mục dự án)
.insightface/
.paddleocr/
*.onnx
